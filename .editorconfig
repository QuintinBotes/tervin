# Kept minimal: only what the two toolchains here disagree about.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,json,yml,yaml,css,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, so trimming them changes meaning.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
